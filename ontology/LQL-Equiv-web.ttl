:software a wsem:Software, schema:SoftwareSourceCode ;
    schema:name "LQL-Equiv-web 3.0: biologically equivalent doses in radiotherapy (Python, browser)" ;
    schema:codeRepository <https://github.com/cyrilvoyant/LQL-Equiv-web> ;
